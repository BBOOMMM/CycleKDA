{
  "model_type": "kimi_linear",
  "architectures": ["KimiLinearForCausalLM"],

  "vocab_size": 163840,
  "bos_token_id": 163584,
  "eos_token_id": 163586,
  "pad_token_id": 163839,

  "dtype": "bfloat16",
  "tie_word_embeddings": false,
  "use_cache": true,
  "model_max_length": 2048,

  "hidden_size": 512,
